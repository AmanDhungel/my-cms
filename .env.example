# Local MongoDB, or an Atlas connection string.
MONGODB_URI="mongodb://127.0.0.1:27017/ems"

# Optional: overrides the database encoded in MONGODB_URI.
MONGODB_DB="ems"

# Signs the session cookie. At least 32 characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing session.
AUTH_SECRET=""

# Emails allowed into the super admin area at /admin. Comma-separated.
# These accounts can block a business or a person across every workspace.
SUPER_ADMIN_EMAILS=""

# --- File uploads (S3) ----------------------------------------------------
# The bucket's region, e.g. ap-south-1 (Mumbai) or us-east-1.
AWS_REGION="ap-south-1"

# The bucket files are written to (private). In use: the bucket blocks all
# public access and is read only through a CloudFront distribution with
# Origin Access Control (OAC). Its bucket policy allows exactly one thing:
# s3:GetObject on arn:aws:s3:::<bucket>/businesses/* for the principal
# cloudfront.amazonaws.com, with the condition AWS:SourceArn equal to that
# distribution's ARN. Nothing else reads it; a direct S3 URL answers 403.
# Every object is written with Cache-Control "public, max-age=31536000,
# immutable" (keys are fresh UUIDs, never overwritten).
AWS_BUCKET_NAME=""

# The CloudFront distribution in front of the bucket, no trailing slash,
# e.g. https://d111111abcdef8.cloudfront.net. Every stored picture is served
# from here (object keys are appended), old bucket links included, and it is
# the one picture origin the Content-Security-Policy allows. Leave empty only
# for a deployment that still serves from a public bucket (a policy granting
# public s3:GetObject on <bucket>/businesses/*).
AWS_PUBLIC_BASE_URL=""

# Optional. The bucket pictures lived in before this one. Links into it that
# are still stored are recognised as ours (ownership and delete checks work
# on them) and are served through AWS_PUBLIC_BASE_URL under the same key, so
# those objects must be copied across: scripts/migrate-legacy-urls.mjs
# reports them, and with --copy --write copies them and rewrites the links.
AWS_LEGACY_BUCKET_NAME=""

# An IAM user whose policy is limited to this one bucket — s3:PutObject,
# s3:GetObject and s3:DeleteObject on arn:aws:s3:::<bucket>/* (plus
# s3:GetObject on the legacy bucket while migrating). Never the root
# account's keys.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Security ---------------------------------------------------------------
# Set to 1 only when a reverse proxy in front of the app overwrites
# X-Forwarded-For; per-IP rate limits then use the first entry. Leave unset
# when the app is reached directly.
TRUST_PROXY=
# Local test runs only: RATE_LIMITS=off disables rate limits in development.
# A production build always enforces them.
RATE_LIMITS=

# Opening the first workspace without an invite (POST /api/register with
# bootstrapToken) needs this AND an address in SUPER_ADMIN_EMAILS. Leave it
# unset once the first workspace exists; unset disables the bootstrap path.
SUPER_ADMIN_BOOTSTRAP_TOKEN=
