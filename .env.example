# Local MongoDB, or an Atlas connection string.
MONGODB_URI="mongodb://127.0.0.1:27017/ems"

# Optional: overrides the database encoded in MONGODB_URI.
MONGODB_DB="ems"

# Signs the session cookie. At least 32 characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing session.
AUTH_SECRET=""
