# Local MongoDB, or an Atlas connection string.
MONGODB_URI="mongodb://127.0.0.1:27017/ems"

# Optional: overrides the database encoded in MONGODB_URI.
MONGODB_DB="ems"

# Signs the session cookie. At least 32 characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing session.
AUTH_SECRET=""

# Emails allowed into the super admin area at /admin. Comma-separated.
# These accounts can block a business or a person across every workspace.
SUPER_ADMIN_EMAILS=""

# --- File uploads (S3) ----------------------------------------------------
# The bucket's region, e.g. ap-south-1 (Mumbai) or us-east-1.
AWS_REGION="ap-south-1"

# The bucket files are written to. Create it first. Pictures are read by the
# browser straight from their URL, so one of two setups is needed:
#   (a) allow public read on the businesses/ prefix only — a bucket policy
#       granting s3:GetObject on arn:aws:s3:::<bucket>/businesses/* and
#       nothing wider — and leave AWS_PUBLIC_BASE_URL empty. A bucket that
#       already holds objects under the older site/, sites/, maintenance/ or
#       ticket/ prefixes must also allow s3:GetObject on those, or use
#       option (b); or
#   (b) keep the bucket entirely private and put a CloudFront distribution in
#       front of it, then set AWS_PUBLIC_BASE_URL to that distribution.
AWS_BUCKET_NAME=""

# Optional. The origin pictures are served from when it is not the bucket
# itself — a CloudFront distribution or a custom domain, no trailing slash,
# e.g. https://d111111abcdef8.cloudfront.net. Object keys are appended to it.
# Leave empty to serve from the bucket's own URL (setup (a) above).
AWS_PUBLIC_BASE_URL=""

# An IAM user whose policy is limited to this one bucket — s3:PutObject,
# s3:GetObject and s3:DeleteObject on arn:aws:s3:::<bucket>/*. Never the
# root account's keys.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Security ---------------------------------------------------------------
# Set to 1 only when a reverse proxy in front of the app overwrites
# X-Forwarded-For; per-IP rate limits then use the first entry. Leave unset
# when the app is reached directly.
TRUST_PROXY=
# Local test runs only: RATE_LIMITS=off disables rate limits in development.
# A production build always enforces them.
RATE_LIMITS=

# Opening the first workspace without an invite (POST /api/register with
# bootstrapToken) needs this AND an address in SUPER_ADMIN_EMAILS. Leave it
# unset once the first workspace exists; unset disables the bootstrap path.
SUPER_ADMIN_BOOTSTRAP_TOKEN=
